# Server-side only — never prefix these with VITE_
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_dev_dashboard_client_id
SHOPIFY_CLIENT_SECRET=your_dev_dashboard_client_secret
RESEND_API_KEY=re_xxxxxxxx
PROTOCOL_EMAIL_FROM=Skin Protocol Rx <hello@yourdomain.com>
SHOP_URL=https://skinprotocolrx.com
SHOP_PUBLIC_DOMAIN=skinprotocolrx.com
ALLOWED_ORIGINS=https://skinprotocolrx.com,https://www.skinprotocolrx.com,https://skinprotocolrx.buselmeier.com

# React app: local Vite middleware, or a deployed worker URL
# Staging (static host): leave unset to stub, or point at your Cloudflare worker URL
VITE_PROTOCOL_EMAIL_ENDPOINT=/api/protocol-email
