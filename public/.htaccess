# Skin Protocol Rx — Apache (GreenGeeks / cPanel)
# Copied into dist/ on `pnpm build`.

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS (enable after SSL is active on the subdomain)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Real files (images, scripts, styles) are served as-is.
  # Directories are not: /designs is both a photo folder and an app route.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # A missing asset should stay a 404. App routes have no file extension.
  RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]{1,8}$
  RewriteRule ^ - [L]

  # SPA fallback (safe even with client-side page state)
  RewriteRule ^ index.html [L]
</IfModule>

# Cache: fingerprint JS/CSS hard; images softly (staging overwrites same filenames)
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(index\.html|\.htaccess)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

# Block common secret paths if ever uploaded by mistake
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)^\.(env|git)">
    Require all denied
  </FilesMatch>
</IfModule>
