      'facial oil': 'Facial Oils',
      'facial oils': 'Facial Oils',
      oil: 'Facial Oils',
      oils: 'Facial Oils'
    };

    var SKIN_STATE_LABELS = {
      calm: 'Calm and comfortable',
      dehydrated: 'Dull and dehydrated',
      breakout: 'Breaking out',
      irritated: 'Irritated'
    };

    var state = {
      step: 0,
      skinType: '',
      concerns: [],
      stepsPreference: 'moderate',
      sensitive: null,
      skinRightNow: '',
      recs: [],
      weekly: null,
      optionalTreat: null
    };

    var questions = root.querySelectorAll('[data-step]');
    var bars = root.querySelectorAll('[data-bar]');
    var backBtn = root.querySelector('[data-back]');
    var nextBtn = root.querySelector('[data-next]');
    var finishBtn = root.querySelector('[data-finish]');
    var quizPanel = root.querySelector('[data-quiz-panel]');
    var resultsPanel = root.querySelector('[data-results-panel]');
    var totalSteps = questions.length;

    function norm(s) {
      return String(s || '').toLowerCase().replace(/[\s_]+/g, '-');
    }

    function normalizeType(type) {
      var key = String(type || '').trim().toLowerCase();
      return TYPE_ALIASES[key] || String(type || '').trim();
    }

    function hasTag(product, value) {
      var n = norm(value);
      var hay = [product.type, product.typeLabel].concat(product.tags || []).map(norm);
      return hay.indexOf(n) !== -1
        || hay.indexOf('skin-type-' + n) !== -1
        || hay.indexOf('concern-' + n) !== -1
        || hay.indexOf('category-' + n) !== -1;
    }

    function isSet(product) {
      return hasTag(product, 'Starter Sets')
        || hasTag(product, 'Travel Sets')
        || hasTag(product, 'starter-set')
        || hasTag(product, 'travel-set')
        || /(^|-)(trio|starter|travel|set|sets|seasonal)(-|$)/i.test(product.handle || '')
        || /\b(trio|starter set|travel set|seasonal)\b/i.test(product.title || '');
    }

    function inferMeta(product) {
      var h = String(product.handle || '').toLowerCase();
      var t = String(product.title || '').toLowerCase();
      var meta = {
        step: null,
        typeLabel: normalizeType(product.type),
        skinTypes: ALL_SKIN.slice(),
        concerns: ALL_CONCERNS.slice(),
        vitaminC: false,
        cleanserKind: null,
        moisturizerKind: null
      };

      if (h.indexOf('exfoliat') !== -1 || t.indexOf('exfoliat') !== -1 || t.indexOf('tripleglow') !== -1) {
        meta.step = 'cleanser';
        meta.cleanserKind = 'exfoliating';
        meta.typeLabel = 'Cleansers';
      } else if (h.indexOf('gel-cleanser') !== -1 || t.indexOf('gel cleanser') !== -1) {
        meta.step = 'cleanser';
        meta.cleanserKind = 'gel';
        meta.typeLabel = 'Cleansers';
      } else if (h.indexOf('cleanser') !== -1 || t.indexOf('cleanser') !== -1 || t.indexOf('chamomile') !== -1) {
        meta.step = 'cleanser';
        meta.cleanserKind = 'chamomile';
        meta.typeLabel = 'Cleansers';
      } else if (h.indexOf('toner') !== -1 || t.indexOf('toner') !== -1) {
        meta.step = 'toner';
        meta.typeLabel = 'Toners';
      } else if (
        h.indexOf('vitamin') !== -1 ||
        t.indexOf('vitamin c') !== -1 ||
        t.indexOf('brighten') !== -1 ||
        t.indexOf('l-ascorbic') !== -1
      ) {
        meta.step = 'vitamin-c';
        meta.typeLabel = 'Serums';
        meta.vitaminC = true;
        meta.concerns = QUIZ_CATALOG['vitamin-c-5-serum'].concerns.slice();
      } else if (h.indexOf('hyaluronic') !== -1 || t.indexOf('hyaluronic') !== -1) {
        meta.step = 'hyaluronic';
        meta.typeLabel = 'Serums';
      } else if (h.indexOf('eye') !== -1 || t.indexOf('eye cream') !== -1 || t.indexOf('eye recovery') !== -1) {
        meta.step = 'eye';
        meta.typeLabel = 'Eye Care';
        meta.concerns = QUIZ_CATALOG['eye-cream'].concerns.slice();
      } else if (
        h === 'moisturizer' ||
        h.indexOf('rich-barrier') !== -1 ||
        t.indexOf('rich barrier') !== -1 ||
        t.indexOf('moisturizing cream') !== -1
      ) {
        meta.step = 'moisturizer';
        meta.moisturizerKind = 'rich';
        meta.typeLabel = 'Moisturizers';
        meta.concerns = QUIZ_CATALOG['rich-barrier-cream'].concerns.slice();
      } else if (
        h.indexOf('hydration-cloud') !== -1 ||
        t.indexOf('hydration cloud') !== -1 ||
        h.indexOf('moistur') !== -1 ||
        t.indexOf('moistur') !== -1
      ) {
        meta.step = 'moisturizer';
        meta.moisturizerKind = h.indexOf('cloud') !== -1 || t.indexOf('cloud') !== -1 ? 'light' : 'rich';
        meta.typeLabel = 'Moisturizers';
        meta.concerns = QUIZ_CATALOG['hydration-cloud-cream'].concerns.slice();
      } else if (h.indexOf('holy-grail') !== -1 || h.indexOf('squalane') !== -1 || t.indexOf('holy grail') !== -1) {
        meta.step = 'oil';
        meta.typeLabel = 'Facial Oils';
      } else if (
        h.indexOf('bakuchiol') !== -1 ||
        h.indexOf('matrix') !== -1 ||
        h.indexOf('amino-acid') !== -1 ||
        h.indexOf('beauty-elixir') !== -1 ||
        t.indexOf('bakuchiol') !== -1 ||
        t.indexOf('matrix') !== -1 ||
        t.indexOf('tri-peptide') !== -1 ||
        t.indexOf('peptide') !== -1 ||
        t.indexOf('beauty elixir') !== -1
      ) {
        meta.step = 'treatment';
        meta.typeLabel = 'Serums';
      }

      return meta;
    }

    function applyMeta(product, meta) {
      var out = product;
      out.step = meta.step;
      out.skinTypes = meta.skinTypes;
      out.concerns = meta.concerns;
      out.typeLabel = meta.typeLabel;
      out.type = meta.typeLabel;
      out.vitaminC = !!meta.vitaminC;
      out.cleanserKind = meta.cleanserKind || null;
      out.moisturizerKind = meta.moisturizerKind || null;
      return out;
    }

    function enrichProducts(raw) {
      return (raw || []).map(function (p) {
        var out = {
          id: p.id,
          handle: p.handle,
          title: p.title,
          url: p.url,
          price: p.price,
          price_formatted: p.price_formatted,
          image: p.image,
          type: normalizeType(p.type),
          tags: p.tags || [],
          tagline: p.tagline,
          available: p.available,
          variants: p.variants || []
        };
        var meta = QUIZ_CATALOG[p.handle] || inferMeta(out);
        return applyMeta(out, meta);
      });
    }

    var products = enrichProducts(data.products);

    function matchesSkinType(product, skinType) {
      if (product.skinTypes) return product.skinTypes.indexOf(skinType) !== -1;
      return hasTag(product, skinType);
    }

    function matchesConcern(product, concern) {
      if (product.concerns) return product.concerns.indexOf(concern) !== -1;
      return hasTag(product, concern);
    }

    function matchesSensitive(product) {
      if (product.skinTypes) return product.skinTypes.indexOf('Sensitive') !== -1;
      return hasTag(product, 'Sensitive');
    }

    function pick(pool, fn) {
      for (var i = 0; i < pool.length; i++) if (fn(pool[i])) return pool[i];
      return null;
    }

    function findVariantByStrength(variants, pct) {
      return pick(variants, function (v) {
        return String(v.title || '').indexOf(pct) !== -1;
      });
    }

    function applyVariant(product, variant) {
      if (!variant) return product;
      var out = Object.assign({}, product);
      out.id = variant.id;
      out.price = variant.price;
      out.price_formatted = variant.price_formatted;
      if (variant.title && variant.title !== 'Default Title') {
        out.title = product.title + ' (' + variant.title + ')';
      }
      return out;
    }

    function resolveVitaminC(product, preferGentle) {
      var variants = product.variants || [];
      if (!variants.length) return product;

      var v5 = findVariantByStrength(variants, '5%');
      var v20 = findVariantByStrength(variants, '20%');
      var available = pick(variants, function (v) { return v.available; });
      var chosen;

      if (preferGentle) {
        chosen = v5 || available || v20 || variants[0];
      } else if (v20 && v20.available) {
        chosen = v20;
      } else if (v20) {
        chosen = v20;
      } else {
        chosen = available || v5 || variants[0];
      }

      return applyVariant(product, chosen);
    }

    function hasStep(product, step) {
      if (product.step) return product.step === step;
      var title = (product.title || '').toLowerCase();
      if (step === 'cleanser') return hasTag(product, 'Cleansers');
      if (step === 'toner') return hasTag(product, 'Toners');
      if (step === 'vitamin-c') {
        return (hasTag(product, 'Serums') || product.vitaminC) && (
          title.indexOf('vitamin') !== -1 ||
          title.indexOf('brighten') !== -1 ||
          title.indexOf('ascorbic') !== -1
        );
      }
      if (step === 'hyaluronic') {
        return hasTag(product, 'Serums') && title.indexOf('hyaluronic') !== -1;
      }
      if (step === 'moisturizer') return hasTag(product, 'Moisturizers') && !hasTag(product, 'Eye Care');
      if (step === 'eye') return hasTag(product, 'Eye Care') || title.indexOf('eye recovery') !== -1;
      if (step === 'oil') return hasTag(product, 'Facial Oils') || hasTag(product, 'Oils');
      if (step === 'treatment') {
        return hasTag(product, 'Serums') && (
          title.indexOf('bakuchiol') !== -1 ||
          title.indexOf('matrix') !== -1 ||
          title.indexOf('peptide') !== -1 ||
          title.indexOf('amino') !== -1 ||
          title.indexOf('elixir') !== -1
        );
      }
      return false;
    }

    function catalog() {
      return products.filter(function (p) { return !isSet(p); });
    }

    function byHandle(ids) {
      var list = Array.isArray(ids) ? ids : [ids];
      var pool = catalog();
      var i;
      for (i = 0; i < list.length; i++) {
        var exact = pick(pool, function (p) { return p.handle === list[i]; });
        if (exact) return exact;
      }
      for (i = 0; i < list.length; i++) {
        var needle = list[i];
        var fuzzy = pick(pool, function (p) {
          return (p.handle || '').indexOf(needle) !== -1;
        });
        if (fuzzy) return fuzzy;
      }
      return null;
    }

    function hasConcern(name) {
      return state.concerns.indexOf(name) !== -1;
    }

    function preferGentleSkin() {
      return !!state.sensitive || state.skinType === 'Sensitive';
    }

    /* Irritated: cleanse, tone, calm serum, moisturize. Essentials always include moisturizer. */
    function protocolSize() {
      if (state.skinRightNow === 'irritated') return 4;
      if (state.stepsPreference === 'minimal') return 3;
      var n = 4;
      if (state.stepsPreference === 'complete') {
        var wantEye = hasConcern('Eye Area');
        var includeOil = state.skinRightNow !== 'breakout';
        if (wantEye) n += 1;
        if (includeOil) n += 1;
      }
      return n;
    }

    function pickCleanser(preferGentle) {
      if (state.skinRightNow === 'irritated' || preferGentle || state.skinType === 'Dry') {
        return byHandle(['clarifying-cleanser']) ||
          pick(catalog(), function (p) { return p.cleanserKind === 'chamomile'; });
      }
      if (state.skinRightNow === 'breakout' || state.skinType === 'Oily' || hasConcern('Acne') || hasConcern('Large Pores')) {
        return byHandle(['clarifying-gel-cleanser']) ||
          pick(catalog(), function (p) { return p.cleanserKind === 'gel'; });
      }
      return byHandle(['clarifying-cleanser']) ||
        pick(catalog(), function (p) { return p.cleanserKind === 'chamomile' || hasStep(p, 'cleanser'); });
    }

    function pickVitaminC(preferGentle) {
      if (preferGentle) {
        return byHandle(['brighten-glow-c-5', 'vitamin-c-5-serum']) ||
          resolveVitaminC(pick(catalog(), function (p) { return p.vitaminC || hasStep(p, 'vitamin-c'); }), true);
      }
      return byHandle(['brighten-glow-c-20', 'vitamin-c-20-serum']) ||
        resolveVitaminC(pick(catalog(), function (p) { return p.vitaminC || hasStep(p, 'vitamin-c'); }), false);
    }

    function pickMoisturizer() {
      var wantRich = state.skinRightNow === 'irritated' ||
        state.skinType === 'Dry' ||
        hasConcern('Dry Skin') ||
        (state.skinRightNow === 'dehydrated' && state.skinType !== 'Oily');
      if (wantRich) {
        return byHandle(['rich-barrier-cream', 'moisturizer']) ||
          pick(catalog(), function (p) { return p.moisturizerKind === 'rich'; });
      }
      return byHandle(['hydration-cloud-cream']) ||
        pick(catalog(), function (p) { return p.moisturizerKind === 'light' || hasStep(p, 'moisturizer'); });
    }

    function pickTreatment(preferGentle) {
      if (state.skinRightNow === 'irritated') return byHandle(['matrix-serum']);
      if (state.skinRightNow === 'breakout') {
        return preferGentle ? byHandle(['matrix-serum']) : byHandle(['bakuchiol-renewal-serum']);
      }
      if (hasConcern('Hyperpigmentation') || hasConcern('Brightening') || hasConcern('Sun Damage')) {
        return pickVitaminC(preferGentle);
      }
      if (hasConcern('Aging')) return byHandle(['bakuchiol-renewal-serum']);
      if (hasConcern('Redness')) return byHandle(['matrix-serum']);
      if (hasConcern('Dry Skin')) return byHandle(['beauty-elixir-serum']);
      if (hasConcern('Acne') || hasConcern('Large Pores')) {
        return preferGentle ? byHandle(['matrix-serum']) : byHandle(['bakuchiol-renewal-serum']);
      }
      if (state.skinRightNow === 'dehydrated') {
        return byHandle(['hyaluronic-acid-serum']) || pick(catalog(), function (p) { return hasStep(p, 'hyaluronic'); });
      }
      return byHandle(['amino-acid-serum']);
    }

    function pickWeekly(preferGentle) {
      if (state.skinRightNow === 'dehydrated' || state.skinRightNow === 'irritated') return null;
      if (state.stepsPreference !== 'complete' || preferGentle || state.skinType === 'Dry') return null;
      var weeklyConcerns = ['Acne', 'Aging', 'Brightening', 'Hyperpigmentation', 'Large Pores', 'Sun Damage'];
      if (!weeklyConcerns.some(hasConcern)) return null;
      return byHandle(['tripleglow-exfoliating-cleanser']);
    }

    function isEveningOnlySerum(p) {
      if (!p) return false;
      var h = (p.handle || '').toLowerCase();
      var t = (p.title || '').toLowerCase();
      return h.indexOf('bakuchiol') !== -1 || t.indexOf('bakuchiol') !== -1;
    }

    function productStep(p) {
      if (!p) return 99;
      if (hasStep(p, 'cleanser')) return 1;
      if (hasStep(p, 'toner')) return 2;
      if (hasStep(p, 'eye')) return 4;
      if (hasStep(p, 'moisturizer')) return 5;
      if (hasStep(p, 'oil')) return 6;
      if (hasStep(p, 'treatment') || hasStep(p, 'hyaluronic') || hasStep(p, 'vitamin-c') || p.vitaminC) return 3;
      return 3;
    }

    function displayOrder(list) {
      return list.slice().sort(function (a, b) {
        return productStep(a) - productStep(b) || String(a.title || '').localeCompare(String(b.title || ''));
      });
    }

    function buildProtocol() {
      var preferGentle = preferGentleSkin();
      var wantEye = state.stepsPreference === 'complete' &&
        hasConcern('Eye Area') &&
        state.skinRightNow !== 'irritated';
      var includeOil = state.stepsPreference === 'complete' &&
        state.skinRightNow !== 'breakout' &&
        state.skinRightNow !== 'irritated';

      var cleanser = pickCleanser(preferGentle);
      var toner = byHandle(['rosewater-niacinamide-toner']) || pick(catalog(), function (p) { return hasStep(p, 'toner'); });
      var moisturizer = pickMoisturizer();
      var eye = byHandle(['eye-cream']) || pick(catalog(), function (p) { return hasStep(p, 'eye'); });
      var oil = byHandle(['the-holy-grail']) || pick(catalog(), function (p) { return hasStep(p, 'oil'); });

      var picked;
      if (state.skinRightNow === 'irritated') {
        picked = [cleanser, toner, byHandle(['matrix-serum']), moisturizer].filter(Boolean);
      } else {
        picked = [cleanser, toner].filter(Boolean);
        if (state.stepsPreference !== 'minimal') {
          var treatment = pickTreatment(preferGentle);
          if (treatment) picked.push(treatment);
        }
        if (moisturizer) picked.push(moisturizer);
        if (wantEye && eye) picked.push(eye);
        if (includeOil && oil) picked.push(oil);
      }

      var seen = {};
      var daily = displayOrder(picked.filter(function (p) {
        if (!p || seen[p.id]) return false;
        seen[p.id] = true;
        return true;
      }));

      state.weekly = pickWeekly(preferGentle);
      return daily;
    }

    function optionalTreat() {
      if (state.skinRightNow === 'irritated') return null;
      if (state.stepsPreference !== 'minimal') return null;
      return pickTreatment(preferGentleSkin());
    }

    function splitRoutine(products) {
      var cleanser = pick(products, function (p) { return hasStep(p, 'cleanser'); });
      var toner = pick(products, function (p) { return hasStep(p, 'toner'); });
      var treat = pick(products, function (p) {
        return productStep(p) === 3;
      });
      var eye = pick(products, function (p) { return hasStep(p, 'eye'); });
      var moisturizer = pick(products, function (p) {
        return hasStep(p, 'moisturizer') && !hasStep(p, 'eye');
      });
      var oil = pick(products, function (p) { return hasStep(p, 'oil'); });
      var morningTreat = treat && !isEveningOnlySerum(treat) ? treat : null;
      var morning = [cleanser, toner, morningTreat, eye, moisturizer].filter(Boolean);
      var evening = [cleanser, toner, treat, eye, moisturizer, oil].filter(Boolean);
      return { morning: morning, evening: evening };
    }

    /* One entry per product, tagged with when it is applied. Derived from splitRoutine. */
    function routineEntries(products) {
      var routine = splitRoutine(products);
      var amIds = {};
      var pmIds = {};
      routine.morning.forEach(function (p) { amIds[p.id] = true; });
      routine.evening.forEach(function (p) { pmIds[p.id] = true; });
      return products.map(function (product) {
        var am = !!amIds[product.id];
        var pm = !!pmIds[product.id];
        return { product: product, period: am && pm ? 'both' : am ? 'am' : 'pm' };
      });
    }

    function routinePeriodLabel(period) {
      if (period === 'both') return 'AM & PM';
      if (period === 'am') return 'AM only';
      if (period === 'weekly') return '1–3× weekly';
      return 'PM only';
    }

    function canAdvance() {
      if (state.step === 0) return !!state.skinType;
      if (state.step === 1) return state.concerns.length > 0;
      if (state.step === 3) return state.sensitive !== null;
      if (state.step === 4) return !!state.skinRightNow;
      return true;
    }

    function syncOptions(stepEl) {
      var step = Number(stepEl.getAttribute('data-step'));
      stepEl.querySelectorAll('[data-option]').forEach(function (btn) {
        var value = btn.getAttribute('data-value');
        var on = false;
        if (step === 0) on = state.skinType === value;
        if (step === 1) on = state.concerns.indexOf(value) !== -1;
        if (step === 2) on = state.stepsPreference === value;
        if (step === 3) on = (state.sensitive === true && value === 'yes') || (state.sensitive === false && value === 'no');
        if (step === 4) on = state.skinRightNow === value;
        btn.classList.toggle('is-selected', on);
      });
    }

    function render() {
      questions.forEach(function (el, i) {
        var active = i === state.step;
        el.hidden = !active;
        el.classList.toggle('is-active', active);
        if (active) syncOptions(el);
      });
      bars.forEach(function (bar, i) {
        bar.classList.toggle('is-on', i <= state.step);
      });
      backBtn.disabled = state.step === 0;
      var last = state.step === totalSteps - 1;
      nextBtn.hidden = last;
      finishBtn.hidden = !last;
      nextBtn.disabled = !canAdvance();
      finishBtn.disabled = !canAdvance();
    }

    root.querySelectorAll('[data-option]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var stepEl = btn.closest('[data-step]');
        var step = Number(stepEl.getAttribute('data-step'));
        var value = btn.getAttribute('data-value');
        if (step === 0) state.skinType = value;
        if (step === 1) {
          var i = state.concerns.indexOf(value);
          if (i === -1) state.concerns.push(value);
          else state.concerns.splice(i, 1);
        }
        if (step === 2) state.stepsPreference = value;
        if (step === 3) state.sensitive = value === 'yes';
        if (step === 4) state.skinRightNow = value;
        render();
      });
    });

    backBtn.addEventListener('click', function () {
      state.step = Math.max(0, state.step - 1);
      render();
    });

    nextBtn.addEventListener('click', function () {
      if (!canAdvance()) return;
      state.step = Math.min(totalSteps - 1, state.step + 1);
      render();
    });

    function showResults() {
      state.recs = buildProtocol();
      state.optionalTreat = optionalTreat();
      renderResults();
    }

    function renderResults() {
      quizPanel.hidden = true;
      resultsPanel.hidden = false;

      var sub = root.querySelector('[data-results-sub]');
      var concernText = state.concerns.slice(0, 2).join(', ').toLowerCase();
      sub.textContent = 'Based on your ' + (state.skinType || '').toLowerCase() + ' skin type and ' + concernText + ' concerns. Daily essentials are cleanser, moisturizer, and morning sunscreen — personalized additions only where they help.';

      var recovery = root.querySelector('[data-results-recovery]');
      if (recovery) recovery.hidden = state.skinRightNow !== 'irritated';

      var list = root.querySelector('[data-results-list]');
      var empty = root.querySelector('[data-results-empty]');
      var setup = root.querySelector('[data-results-setup]');
      var totalBox = root.querySelector('[data-results-total]');
      list.innerHTML = '';
      empty.hidden = true;
      setup.hidden = true;

      if (!products.length) {
        setup.hidden = false;
        totalBox.hidden = true;
        return;
      }

      if (!state.recs.length) {
        empty.hidden = false;
        totalBox.hidden = true;
        return;
      }

      empty.hidden = true;
      totalBox.hidden = false;
      var cents = 0;
      var STEP_LABELS = {
        1: 'Step 1 · Cleanse',
        2: 'Step 2 · Tone',
        3: 'Step 3 · Treat',
        4: 'Step 4 · Eye Care',
        5: 'Step 5 · Moisturize',
        6: 'Step 6 · Nourish'
      };
      function appendHeading(text, when) {
        var h = document.createElement('p');
        h.className = 'spq__period';
        h.innerHTML = '<span>' + text + '</span>' + (when ? '<span class="spq__period-when">' + when + '</span>' : '');
        list.appendChild(h);
      }
      function appendRow(p, stepLabel, opts) {
        opts = opts || {};
        if (!opts.skipPrice) cents += Number(p.price) || 0;
        var row = document.createElement('div');
        row.className = 'spq__row' + (opts.guidance ? ' spq__row--guidance' : '');
        row.innerHTML =
          '<div class="spq__step">' + stepLabel + '</div>' +
          '<div class="spq__thumb">' + (p.image ? '<img src="' + p.image + '" alt="">' : '') + '</div>' +
          '<div class="spq__row-body">' +
            '<p class="spq__row-cat">' + (opts.cat || p.typeLabel || p.type || '') + '</p>' +
            '<h3 class="spq__row-name">' + (p.title || p.name) + '</h3>' +
            '<p class="spq__row-tag">' + (opts.tag || p.tagline || '') + '</p>' +
            (opts.skipPrice ? '' : '<p class="spq__row-price">' + p.price_formatted + '</p>') +
          '</div>' +
          '<div class="spq__row-aside">' +
            (opts.period ? '<span class="spq__when">' + routinePeriodLabel(opts.period) + '</span>' : '') +
            (opts.skipPrice || !p.id
              ? ''
              : p.available === false
                ? '<span class="spq__add is-soldout">Sold out</span>'
                : '<button type="button" class="spq__add" data-add-one="' + p.id + '">' + {{ section.settings.item_cart_label | default: 'Add to Cart' | json }} + '</button>') +
            (p.url ? '<a class="spq__view" href="' + p.url + '">View →</a>' : '') +
          '</div>';
        list.appendChild(row);
      }
      function appendOptional(p) {
        if (!p) return;
        var period = isEveningOnlySerum(p) ? 'pm' : 'both';
        var wrap = document.createElement('div');
        wrap.className = 'spq__optional';
        wrap.setAttribute('data-optional', '');
        wrap.innerHTML =
          '<button type="button" class="spq__optional-toggle" data-optional-toggle aria-expanded="false">' +
            '<div class="spq__step spq__step--ghost">3</div>' +
            '<div class="spq__row-body">' +
              '<p class="spq__row-cat">Step 3 · Treat</p>' +
              '<p class="spq__optional-tease">Add a personalized serum</p>' +
            '</div>' +
            '<span class="spq__optional-plus" data-optional-symbol aria-hidden="true">+</span>' +
          '</button>' +
          '<div class="spq__optional-body" data-optional-body hidden>' +
            '<div class="spq__thumb">' + (p.image ? '<img src="' + p.image + '" alt="">' : '') + '</div>' +
            '<div class="spq__row-body">' +
              '<p class="spq__row-cat">' + (p.typeLabel || p.type || '') + '</p>' +
              '<h3 class="spq__row-name">' + (p.title || p.name) + '</h3>' +
              '<p class="spq__row-tag">' + (p.tagline || '') + '</p>' +
              '<p class="spq__row-price">' + (p.price_formatted || '') + '</p>' +
            '</div>' +
            '<div class="spq__row-aside">' +
              '<span class="spq__when">' + routinePeriodLabel(period) + '</span>' +
              '<button type="button" class="spq__add-treat" data-add-treat>Add to my protocol</button>' +
              (p.url ? '<a class="spq__view" href="' + p.url + '">View →</a>' : '') +
            '</div>' +
          '</div>';
        list.appendChild(wrap);
      }
      var entries = routineEntries(state.recs);
      appendHeading('Your Daily Routine', 'When to apply');
      entries.forEach(function (entry) {
        var p = entry.product;
        appendRow(p, STEP_LABELS[productStep(p)] || String(productStep(p)), { period: entry.period });
        if (productStep(p) === 2) appendOptional(state.optionalTreat);
      });
      appendRow(
        {
          title: 'Broad-spectrum SPF 30+',
          tagline: 'Finish the morning routine with sunscreen — even if purchased separately.',
          typeLabel: 'Step 7 · Protect',
          image: '',
          price: 0,
          price_formatted: '',
          url: ''
        },
        '7',
        { guidance: true, skipPrice: true, cat: 'Step 7 · Protect', tag: 'Use your preferred SPF 30+.', period: 'am' }
      );
      if (state.weekly) {
        appendHeading('Weekly · Polish');
        appendRow(state.weekly, 'W', { period: 'weekly' });
      }

      var count = state.recs.length + (state.weekly ? 1 : 0);
      root.querySelector('[data-total-price]').textContent = formatCents(cents);
      root.querySelector('[data-total-count]').textContent = count + ' products';
      state.entries = entries;
    }

    var emailEndpoint = {{ section.settings.email_endpoint_url | json }};
    var emailModal = root.querySelector('[data-email-modal]');
    var emailFormPanel = root.querySelector('[data-email-form]');
    var emailSuccessPanel = root.querySelector('[data-email-success]');
    var emailSubmitForm = root.querySelector('[data-email-submit-form]');
    var emailError = root.querySelector('[data-email-error]');
    var emailInput = root.querySelector('[data-email-input]');
    var firstNameInput = root.querySelector('[data-first-name-input]');
    var marketingInput = root.querySelector('[data-marketing-input]');
    var emailSendBtn = root.querySelector('[data-email-send]');

    function protocolProducts() {
      return state.weekly ? state.recs.concat([state.weekly]) : state.recs.slice();
    }

    function buildProtocolPayload() {
      var entries = state.entries || routineEntries(state.recs);
      var items = protocolProducts();
      var cents = items.reduce(function (sum, p) { return sum + (Number(p.price) || 0); }, 0);
      var products = entries.map(function (entry) {
        return {
          name: entry.product.title,
          price: entry.product.price_formatted,
          step: productStep(entry.product),
          period: entry.period,
          url: entry.product.url || undefined
        };
      });
      products.push({
        name: 'Broad-spectrum SPF 30+',
        price: 'Purchased separately',
        step: 7,
        period: 'am'
      });
      if (state.weekly) {
        products.push({
          name: state.weekly.title,
          price: state.weekly.price_formatted,
          step: 'W',
          period: 'weekly',
          url: state.weekly.url || undefined
        });
      }
      return {
        email: '',
        firstName: '',
        marketingConsent: false,
        protocol: {
          skinType: state.skinType || '',
          concerns: state.concerns.slice(),
          skinRightNow: SKIN_STATE_LABELS[state.skinRightNow] || '',
          note: state.skinRightNow === 'irritated'
            ? "Your skin is irritated right now, so this is a short recovery routine without active ingredients. Come back in two to three weeks and we'll add your treatment serum."
            : undefined,
          products: products,
          totalPrice: formatCents(cents)
        }
      };
    }

    function openEmailModal() {
      if (!emailModal) return;
      emailModal.hidden = false;
      emailFormPanel.hidden = false;
      emailSuccessPanel.hidden = true;
      emailError.hidden = true;
      emailError.textContent = '';
      if (emailSubmitForm) emailSubmitForm.reset();
      document.body.style.overflow = 'hidden';
      if (emailInput) emailInput.focus();
    }

    function closeEmailModal() {
      if (!emailModal || emailSendBtn && emailSendBtn.disabled) return;
      emailModal.hidden = true;
      document.body.style.overflow = '';
    }

    function stubSubmitProtocol(payload) {
      return new Promise(function (resolve) {
        setTimeout(function () {
          console.info('[Protocol Email] Stub submit — Phase 2 will POST to Shopify Customer API', payload);
          resolve();
        }, 800);
      });
    }

    function submitProtocolEmail(payload) {
      if (!emailEndpoint) return stubSubmitProtocol(payload);
      return fetch(emailEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload)
      }).then(function (res) {
        if (res.ok) return;
        return res.text().then(function (text) {
          var message = text;
          try {
            var parsed = JSON.parse(text);
            if (parsed && parsed.error) message = parsed.error;
          } catch (e) {}
          throw new Error(message || 'Could not send your protocol. Please try again.');
        });
      });
    }

    root.querySelectorAll('[data-email-open]').forEach(function (btn) {
      btn.addEventListener('click', openEmailModal);
    });

    root.querySelectorAll('[data-email-close]').forEach(function (btn) {
      btn.addEventListener('click', closeEmailModal);
    });

    if (emailSubmitForm) {
      emailSubmitForm.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!emailInput || !emailInput.value.trim()) return;

        var payload = buildProtocolPayload();
        payload.email = emailInput.value.trim();
        payload.firstName = firstNameInput && firstNameInput.value.trim() ? firstNameInput.value.trim() : undefined;
        payload.marketingConsent = !!(marketingInput && marketingInput.checked);

        emailError.hidden = true;
        emailSendBtn.disabled = true;
        emailSendBtn.textContent = 'Sending…';

        submitProtocolEmail(payload)
          .then(function () {
            emailFormPanel.hidden = true;
            emailSuccessPanel.hidden = false;
          })
          .catch(function (err) {
            emailError.hidden = false;
            emailError.textContent = err && err.message ? err.message : 'Could not send your protocol. Please try again.';
          })
          .finally(function () {
            emailSendBtn.disabled = false;
            emailSendBtn.textContent = {{ section.settings.email_send_label | json }};
          });
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && emailModal && !emailModal.hidden) closeEmailModal();
    });

    function formatCents(cents) {
      if (state.recs[0] && state.recs[0].price_formatted) {
        var sample = state.recs[0].price_formatted;
        var n = (cents / 100).toFixed(2);
        return sample.replace(/[\d,]+\.?\d*/, function () { return n; });
      }
      return '$' + (cents / 100).toFixed(2);
    }

    finishBtn.addEventListener('click', function () {
      if (!canAdvance()) return;
      showResults();
    });

    root.querySelector('[data-restart]').addEventListener('click', function () {
      state = { step: 0, skinType: '', concerns: [], stepsPreference: 'moderate', sensitive: null, skinRightNow: '', recs: [], weekly: null, optionalTreat: null };
      quizPanel.hidden = false;
      resultsPanel.hidden = true;
      render();
      root.scrollIntoView({ behavior: 'smooth' });
    });

    function cartItemsPayload(recs) {
      return recs.map(function (p) {
        return { id: Number(p.id), quantity: 1 };
      });
    }

    function postCart(url, body) {
      return fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify(body)
      }).then(function (res) {
        return res.json().then(function (payload) {
          return { ok: res.ok, status: res.status, payload: payload };
        });
      });
    }

    function addItemsSequentially(url, recs) {
      var added = [];
      var failed = [];
      var chain = Promise.resolve();

      recs.forEach(function (product) {
        chain = chain.then(function () {
          return postCart(url, { id: Number(product.id), quantity: 1 }).then(function (result) {
            if (result.ok) {
              added.push(product);
              return;
            }
            var message = (result.payload && (result.payload.description || result.payload.message))
              || 'This item is unavailable.';
            failed.push({ title: product.title, message: message });
          });
        });
      });

      return chain.then(function () {
        return { added: added, failed: failed };
      });
    }

    function addProtocolToCart(recs) {
      var url = data.cartAdd.indexOf('.js') !== -1 ? data.cartAdd : data.cartAdd + '.js';
      var items = cartItemsPayload(recs);

      return postCart(url, { items: items }).then(function (result) {
        if (result.ok) {
          return { added: recs.slice(), failed: [] };
        }

        return addItemsSequentially(url, recs);
      });
    }

    /* Optional serum accordion + single-product add. */
    root.querySelector('[data-results-list]').addEventListener('click', function (event) {
      var target = event.target;
      if (target && target.nodeType !== 1) target = target.parentElement;
      if (!target || !target.closest) return;

      var toggle = target.closest('[data-optional-toggle]');
      if (toggle) {
        var wrap = toggle.closest('[data-optional]');
        if (!wrap) return;
        var open = wrap.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        var body = wrap.querySelector('[data-optional-body]');
        if (body) body.hidden = !open;
        var symbol = wrap.querySelector('[data-optional-symbol]');
        if (symbol) symbol.textContent = open ? '−' : '+';
        return;
      }

      var addTreat = target.closest('[data-add-treat]');
      if (addTreat && state.optionalTreat) {
        state.recs = displayOrder(state.recs.concat([state.optionalTreat]));
        state.optionalTreat = null;
        renderResults();
        return;
      }

      var btn = target.closest('[data-add-one]');
      if (!btn) return;

      var product = protocolProducts().find(function (p) {
        return String(p.id) === btn.getAttribute('data-add-one');
      });
      if (!product) return;

      var msg = root.querySelector('[data-cart-msg]');
      var label = btn.textContent;
      btn.disabled = true;
      msg.hidden = true;

      var url = data.cartAdd.indexOf('.js') !== -1 ? data.cartAdd : data.cartAdd + '.js';
      postCart(url, { id: Number(product.id), quantity: 1 })
        .then(function (result) {
          if (result.ok) {
            btn.classList.add('is-added');
            btn.textContent = 'Added ✓';
            return;
          }
          btn.textContent = label;
          btn.disabled = false;
          msg.hidden = false;
          msg.textContent = product.title + ': '
            + ((result.payload && (result.payload.description || result.payload.message)) || 'This item is unavailable.');
        })
        .catch(function () {
          btn.textContent = label;
          btn.disabled = false;
          msg.hidden = false;
          msg.textContent = 'Could not add to cart. Please try again.';
        });
    });

    root.querySelector('[data-add-cart]').addEventListener('click', function () {
      var btn = root.querySelector('[data-add-cart]');
      var msg = root.querySelector('[data-cart-msg]');
      var cartItems = protocolProducts();
      if (!cartItems.length) return;

      btn.disabled = true;
      msg.hidden = true;

      addProtocolToCart(cartItems)
        .then(function (result) {
          if (result.added.length) {
            if (result.failed.length) {
              msg.hidden = false;
              msg.textContent = 'Added ' + result.added.length + ' of ' + cartItems.length
                + ' products. Some items are unavailable for pre-order.';
              setTimeout(function () {
                window.location.href = data.cartUrl;
              }, 1800);
              return;
            }
            window.location.href = data.cartUrl;
            return;
          }

          var firstError = result.failed[0];
          msg.hidden = false;
          msg.textContent = firstError
            ? firstError.title + ': ' + firstError.message
            : 'Could not add to cart. Please try again.';
        })
        .catch(function () {
          msg.hidden = false;
          msg.textContent = 'Could not add to cart. Please try again.';
        })
        .finally(function () {
          btn.disabled = false;
        });
    });

    render();
  })();
</script>

