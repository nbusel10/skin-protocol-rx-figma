        skinTypes: ALL_SKIN.slice(),
        concerns: ['Aging', 'Brightening', 'Dry Skin', 'Preventative', 'Redness', 'Sun Damage']
      }
    };

    var TYPE_ALIASES = {
      cleanser: 'Cleansers',
      cleansers: 'Cleansers',
      toner: 'Toners',
      toners: 'Toners',
      serum: 'Serums',
      serums: 'Serums',
      cream: 'Moisturizers',
