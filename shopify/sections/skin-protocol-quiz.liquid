{% comment %}
  Protocol Quiz — Online Store 2.0 custom section
  File: sections/skin-protocol-quiz.liquid

  Setup
  1. Create a manual collection named "Protocol Quiz" with quiz-eligible products
     (exclude starter sets and seasonal SKUs). Preferred catalog from Master Ingredient List:
       - Chamomile Cream Cleanser              (handle: clarifying-cleanser)
       - Clarifying Gel Cleanser               (handle: clarifying-gel-cleanser)
       - TripleGlow Exfoliating Cleanser       (handle: tripleglow-exfoliating-cleanser) — optional weekly
       - Niacinamide Rosewater Restorative Toner (handle: rosewater-niacinamide-toner)
       - Brighten & Glow C Serum / Vitamin C   (handle: vitamin-c-5-serum) — 5% / 20% variants
       - Hyaluronic Acid Serum                 (handle: hyaluronic-acid-serum)
       - Hydration Cloud Cream                 (handle: hydration-cloud-cream)
       - Rich Barrier Cream                    (handle: rich-barrier-cream)
         · also accepts live handle moisturizer as alias
       - Eye Recovery Complex                  (handle: eye-cream)
       - The Holy Grail Oil                    (handle: the-holy-grail)
       - Tri-peptide Complex Serum             (handle: amino-acid-serum)
       - Matrix Serum                          (handle: matrix-serum)
       - Bakuchiol Renewal Serum               (handle: bakuchiol-renewal-serum)
       - Beauty Elixir Serum                   (handle: beauty-elixir-serum)
  2. In the theme editor, add this section to a page and select that collection.
  3. Handle-based quiz metadata is built into the section JS — product tags and
     types are optional. Optional later: set Product type to Cleansers, Toners,
     Serums, Moisturizers, Eye Care, or Facial Oils, and tag skin types/concerns.
  4. Optional metafield: custom.tagline (single line text)
{% endcomment %}

{%- liquid
  assign quiz_collection = section.settings.product_collection
  assign accent = section.settings.accent
  assign accent_light = section.settings.accent_light
  assign charcoal = section.settings.charcoal
  assign ivory = section.settings.ivory
-%}

<div
  id="ProtocolQuiz-{{ section.id }}"
  class="spq"
  style="
    --spq-accent: {{ accent }};
    --spq-accent-light: {{ accent_light }};
    --spq-accent-dark: {{ section.settings.accent_dark }};
    --spq-charcoal: {{ charcoal }};
    --spq-ivory: {{ ivory }};
    --spq-gray: {{ section.settings.gray }};
  "
>
  <div class="spq__inner" data-quiz-panel>
    <div class="spq__progress" aria-hidden="true">
      {%- for i in (1..5) -%}
        <span class="spq__bar{% if forloop.first %} is-on{% endif %}" data-bar></span>
      {%- endfor -%}
    </div>

    <div class="spq__card" data-questions>
      <div class="spq__question is-active" data-step="0" data-required="single">
        <p class="spq__kicker">Question 1 of 5</p>
        <h2 class="spq__title">{{ section.settings.q1_title }}</h2>
        <div class="spq__grid spq__grid--3">
          {%- assign types = 'Combination,Dry,Normal,Oily,Sensitive' | split: ',' -%}
          {%- for t in types -%}
            <button type="button" class="spq__opt" data-option data-value="{{ t }}">
              <span class="spq__opt-label">{{ t }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="spq__question" data-step="1" data-required="multi" hidden>
        <p class="spq__kicker">Question 2 of 5</p>
        <h2 class="spq__title">{{ section.settings.q2_title }}</h2>
        <p class="spq__hint">Select all that apply</p>
        <div class="spq__grid spq__grid--3">
          {%- assign concerns = 'Acne,Aging,Brightening,Dry Skin,Eye Area,Hyperpigmentation,Large Pores,Preventative,Redness,Sun Damage' | split: ',' -%}
          {%- for c in concerns -%}
            <button type="button" class="spq__opt" data-option data-value="{{ c }}">
              <span class="spq__opt-label">{{ c }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="spq__question" data-step="2" data-required="none" hidden>
        <p class="spq__kicker">Question 3 of 5</p>
        <h2 class="spq__title">{{ section.settings.q3_title }}</h2>
        <div class="spq__grid spq__grid--3">
          <button type="button" class="spq__opt" data-option data-value="minimal">
            <span class="spq__opt-label">Minimal (2–3 steps)</span>
            <span class="spq__opt-desc">Quick and simple</span>
          </button>
          <button type="button" class="spq__opt is-selected" data-option data-value="moderate">
            <span class="spq__opt-label">Moderate (4–5 steps)</span>
            <span class="spq__opt-desc">Balanced routine</span>
          </button>
          <button type="button" class="spq__opt" data-option data-value="complete">
            <span class="spq__opt-label">Complete (6 steps)</span>
            <span class="spq__opt-desc">Full protocol</span>
          </button>
        </div>
      </div>

      <div class="spq__question" data-step="3" data-required="single" hidden>
        <p class="spq__kicker">Question 4 of 5</p>
        <h2 class="spq__title">{{ section.settings.q4_title }}</h2>
        <div class="spq__grid spq__grid--2 spq__grid--narrow">
          <button type="button" class="spq__opt" data-option data-value="yes">
            <span class="spq__opt-label">Yes</span>
          </button>
          <button type="button" class="spq__opt" data-option data-value="no">
            <span class="spq__opt-label">No</span>
          </button>
        </div>
      </div>

      <div class="spq__question" data-step="4" data-required="none" hidden>
        <p class="spq__kicker">Question 5 of 5</p>
        <h2 class="spq__title">{{ section.settings.q5_title }}</h2>
        <div class="spq__grid spq__grid--2">
          <button type="button" class="spq__opt is-selected" data-option data-value="starter" data-default>
            <span class="spq__opt-label">Starter Routine</span>
            <span class="spq__opt-desc">A simple foundation to begin with</span>
          </button>
          <button type="button" class="spq__opt" data-option data-value="complete">
            <span class="spq__opt-label">Complete Protocol</span>
            <span class="spq__opt-desc">A full, optimized daily routine</span>
          </button>
        </div>
      </div>
    </div>

    <div class="spq__nav">
      <button type="button" class="spq__back" data-back disabled>← Back</button>
      <button type="button" class="spq__next" data-next disabled>{{ section.settings.continue_label }}</button>
      <button type="button" class="spq__finish" data-finish hidden>{{ section.settings.finish_label }}</button>
    </div>
  </div>

  <div class="spq__results" data-results-panel hidden>
    <div class="spq__results-head">
      <p class="spq__kicker">Your Custom Protocol</p>
      <h2 class="spq__results-title">{{ section.settings.results_title }}</h2>
      <p class="spq__results-sub" data-results-sub></p>
    </div>
    <div class="spq__list" data-results-list></div>
    <p class="spq__empty" data-results-empty hidden>No matching products were found. Try a broader skin type or fewer concerns.</p>
    <p class="spq__empty" data-results-setup hidden>In the theme editor, open this section and select your Protocol Quiz collection under Protocol products.</p>
    <div class="spq__total" data-results-total hidden>
      <div class="spq__total-row">
        <div>
          <p class="spq__total-kicker">Protocol Total</p>
          <p class="spq__total-price" data-total-price></p>
        </div>
        <div class="spq__total-meta">
          <p data-total-count></p>
          <p>Morning &amp; Evening</p>
        </div>
      </div>
      <div class="spq__total-actions">
        <button type="button" class="spq__cart" data-add-cart>{{ section.settings.cart_label }}</button>
        <button type="button" class="spq__email" data-email-open>{{ section.settings.email_label }}</button>
      </div>
      <p class="spq__cart-msg" data-cart-msg hidden></p>
    </div>
    <div class="spq__restart-wrap">
      <button type="button" class="spq__restart" data-restart>Start Over</button>
    </div>
  </div>

  <div class="spq__modal" data-email-modal hidden>
    <div class="spq__modal-backdrop" data-email-close tabindex="-1" aria-hidden="true"></div>
    <div class="spq__modal-panel" role="dialog" aria-modal="true" aria-labelledby="spq-email-title-{{ section.id }}">
      <div class="spq__modal-form" data-email-form>
        <div class="spq__modal-head">
          <h3 class="spq__modal-title" id="spq-email-title-{{ section.id }}">{{ section.settings.email_modal_title }}</h3>
          <p class="spq__modal-desc">{{ section.settings.email_modal_desc }}</p>
        </div>
        <form data-email-submit-form novalidate>
          <label class="spq__field">
            <span class="spq__field-label">Email Address</span>
            <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" data-email-input>
          </label>
          <label class="spq__field">
            <span class="spq__field-label">First Name <span class="spq__optional">(optional)</span></span>
            <input type="text" name="firstName" autocomplete="given-name" placeholder="Your first name" data-first-name-input>
          </label>
          <label class="spq__check">
            <input type="checkbox" name="marketing" value="1" data-marketing-input>
            <span class="spq__check-box" aria-hidden="true"></span>
            <span class="spq__check-label">{{ section.settings.marketing_label }}</span>
          </label>
          <p class="spq__privacy">{{ section.settings.privacy_note }}</p>
          <p class="spq__email-error" data-email-error hidden role="alert"></p>
          <div class="spq__modal-actions">
            <button type="submit" class="spq__modal-send" data-email-send>{{ section.settings.email_send_label }}</button>
            <button type="button" class="spq__modal-cancel" data-email-close>{{ section.settings.email_cancel_label }}</button>
          </div>
        </form>
      </div>
      <div class="spq__modal-success" data-email-success hidden>
        <div class="spq__success-icon" aria-hidden="true">✓</div>
        <h3 class="spq__modal-title">{{ section.settings.email_success_title }}</h3>
        <p class="spq__modal-desc">{{ section.settings.email_success_desc }}</p>
        <button type="button" class="spq__modal-send spq__modal-done" data-email-close>{{ section.settings.email_done_label }}</button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="ProtocolQuizData-{{ section.id }}">
{
  "cartAdd": {{ routes.cart_add_url | append: '.js' | json }},
  "cartUrl": {{ routes.cart_url | json }},
  "products": [
    {%- if quiz_collection != blank -%}
      {%- for product in quiz_collection.products limit: 250 -%}
        {%- assign variant = product.selected_or_first_available_variant -%}
        {
          "id": {{ variant.id | json }},
          "handle": {{ product.handle | json }},
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "price": {{ variant.price | json }},
          "price_formatted": {{ variant.price | money | json }},
          "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 240 | json }}{% else %}null{% endif %},
          "type": {{ product.type | json }},
          "tags": {{ product.tags | json }},
          "tagline": {{ product.metafields.custom.tagline.value | default: product.type | json }},
          "available": {{ product.available | json }},
          "variants": [
            {%- for v in product.variants -%}
              {
                "id": {{ v.id | json }},
                "title": {{ v.title | json }},
                "available": {{ v.available | json }},
                "price": {{ v.price | json }},
                "price_formatted": {{ v.price | money | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
  ]
}
</script>

<style>
  #ProtocolQuiz-{{ section.id }} {
    background: var(--spq-ivory);
    font-family: 'DM Sans', system-ui, sans-serif;
    color: var(--spq-charcoal);
    padding: 5.6rem 2rem;
  }
  @media (min-width: 768px) {
    #ProtocolQuiz-{{ section.id }} {
      padding: 7.2rem 3.2rem;
    }
  }
  #ProtocolQuiz-{{ section.id }} .spq__inner,
  #ProtocolQuiz-{{ section.id }} .spq__results {
    max-width: 88rem;
    margin: 0 auto;
  }
  #ProtocolQuiz-{{ section.id }} .spq__progress {
    display: flex;
    gap: 8px;
    margin-bottom: 3.6rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__bar {
    height: 6px;
    flex: 1;
    background: var(--spq-gray);
    transition: background 0.3s ease;
  }
  #ProtocolQuiz-{{ section.id }} .spq__bar.is-on {
    background: var(--spq-accent);
  }
  #ProtocolQuiz-{{ section.id }} .spq__card {
    background: #fff;
    border: 1px solid var(--spq-gray);
    padding: 3.2rem 2.8rem;
  }
  @media (min-width: 640px) {
    #ProtocolQuiz-{{ section.id }} .spq__card {
      padding: 4.4rem 4.8rem;
    }
  }
  #ProtocolQuiz-{{ section.id }} .spq__kicker {
    font-size: 1.4rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--spq-accent);
    margin: 0 0 1.2rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    font-weight: 400;
    margin: 0 0 2.8rem;
    line-height: 1.25;
  }
  #ProtocolQuiz-{{ section.id }} .spq__hint {
    font-size: 1.5rem;
    color: rgba(37, 37, 37, 0.4);
    margin: -1.6rem 0 1.6rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__grid {
    display: grid;
    gap: 1.4rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__grid--2 { grid-template-columns: 1fr 1fr; }
  #ProtocolQuiz-{{ section.id }} .spq__grid--3 { grid-template-columns: 1fr; }
  #ProtocolQuiz-{{ section.id }} .spq__grid--narrow { max-width: 36rem; }
  @media (min-width: 640px) {
    #ProtocolQuiz-{{ section.id }} .spq__grid--3 { grid-template-columns: repeat(3, 1fr); }
  }
  #ProtocolQuiz-{{ section.id }} .spq__opt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 6px;
    text-align: left;
    border: 1px solid var(--spq-gray);
    background: #fff;
    padding: 1.8rem 2rem;
    min-height: 6.4rem;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    font: inherit;
    color: inherit;
  }
  #ProtocolQuiz-{{ section.id }} .spq__opt.is-selected {
    border-color: var(--spq-accent);
    background: var(--spq-accent-light);
  }
  #ProtocolQuiz-{{ section.id }} .spq__opt-label {
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.3;
  }
  #ProtocolQuiz-{{ section.id }} .spq__opt.is-selected .spq__opt-label {
    color: var(--spq-accent);
  }
  #ProtocolQuiz-{{ section.id }} .spq__opt-desc {
    font-size: 1.3rem;
    color: rgba(37, 37, 37, 0.4);
  }
  #ProtocolQuiz-{{ section.id }} .spq__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2.4rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__back,
  #ProtocolQuiz-{{ section.id }} .spq__restart {
    background: none;
    border: 0;
    font: inherit;
    font-size: 1.4rem;
    color: rgba(37, 37, 37, 0.4);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0.8rem 0;
  }
  #ProtocolQuiz-{{ section.id }} .spq__back:disabled {
    opacity: 0.3;
    cursor: default;
    text-decoration: none;
  }
  #ProtocolQuiz-{{ section.id }} .spq__next,
  #ProtocolQuiz-{{ section.id }} .spq__finish,
  #ProtocolQuiz-{{ section.id }} .spq__cart {
    background: var(--spq-charcoal);
    color: #fff;
    border: 0;
    font: inherit;
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 1.35rem 2.75rem;
    cursor: pointer;
  }
  #ProtocolQuiz-{{ section.id }} .spq__finish,
  #ProtocolQuiz-{{ section.id }} .spq__cart {
    background: var(--spq-accent);
  }
  #ProtocolQuiz-{{ section.id }} .spq__next:hover,
  #ProtocolQuiz-{{ section.id }} .spq__finish:hover,
  #ProtocolQuiz-{{ section.id }} .spq__cart:hover {
    filter: brightness(0.92);
  }
  #ProtocolQuiz-{{ section.id }} .spq__next:disabled {
    opacity: 0.4;
    cursor: default;
    filter: none;
  }
  #ProtocolQuiz-{{ section.id }} .spq__results-head {
    text-align: center;
    margin-bottom: 4rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__results-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.8rem, 4vw, 3.8rem);
    font-weight: 400;
    margin: 0 0 1.2rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__results-sub {
    font-size: 1.6rem;
    color: rgba(37, 37, 37, 0.5);
    margin: 0;
  }
  #ProtocolQuiz-{{ section.id }} .spq__row {
    display: flex;
    gap: 1.8rem;
    background: #fff;
    border: 1px solid var(--spq-gray);
    padding: 1.8rem;
    margin-bottom: 1.2rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__step {
    width: 3.2rem;
    height: 3.2rem;
    flex-shrink: 0;
    background: var(--spq-accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: 600;
  }
  #ProtocolQuiz-{{ section.id }} .spq__thumb {
    width: 7.2rem;
    height: 7.2rem;
    flex-shrink: 0;
    background: #fff;
    overflow: hidden;
    padding: 0.8rem;
    box-sizing: border-box;
  }
  #ProtocolQuiz-{{ section.id }} .spq__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  #ProtocolQuiz-{{ section.id }} .spq__row-body { flex: 1; min-width: 0; }
  #ProtocolQuiz-{{ section.id }} .spq__row-cat {
    font-size: 1.2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(37, 37, 37, 0.4);
    margin: 0 0 0.4rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__row-name {
    font-size: 1.7rem;
    font-weight: 500;
    margin: 0 0 0.4rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__row-tag {
    font-size: 1.4rem;
    color: rgba(37, 37, 37, 0.5);
    margin: 0 0 0.6rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__row-price {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }
  #ProtocolQuiz-{{ section.id }} .spq__view {
    display: none;
    align-self: center;
    font-size: 1.4rem;
    color: var(--spq-accent);
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    #ProtocolQuiz-{{ section.id }} .spq__view { display: inline; }
  }
  #ProtocolQuiz-{{ section.id }} .spq__total {
    background: var(--spq-charcoal);
    color: #fff;
    padding: 2.8rem;
    margin-top: 3.2rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__total-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__total-kicker {
    font-size: 1.3rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 0.4rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__total-price {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3.2rem;
    margin: 0;
  }
  #ProtocolQuiz-{{ section.id }} .spq__total-meta {
    text-align: right;
    font-size: 1.4rem;
    color: rgba(255, 255, 255, 0.5);
  }
  #ProtocolQuiz-{{ section.id }} .spq__total-meta p { margin: 0; }
  #ProtocolQuiz-{{ section.id }} .spq__total-actions {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  @media (min-width: 640px) {
    #ProtocolQuiz-{{ section.id }} .spq__total-actions { flex-direction: row; }
  }
  #ProtocolQuiz-{{ section.id }} .spq__cart,
  #ProtocolQuiz-{{ section.id }} .spq__email {
    flex: 1;
    text-align: center;
    text-decoration: none;
  }
  #ProtocolQuiz-{{ section.id }} .spq__email {
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    color: #fff;
    font-size: 1.4rem;
    font-weight: 500;
    padding: 1.35rem 2rem;
    cursor: pointer;
    font-family: inherit;
  }
  #ProtocolQuiz-{{ section.id }} .spq__email:hover {
    border-color: #fff;
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal[hidden] {
    display: none !important;
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(37, 37, 37, 0.6);
    border: none;
    cursor: pointer;
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal-panel {
    position: relative;
    width: 100%;
    max-width: 44rem;
    background: #fff;
    border: 1px solid var(--spq-gray);
    box-shadow: 0 2rem 4rem rgba(0, 0, 0, 0.12);
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal-head {
    padding: 2.4rem 2.4rem 0;
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.4rem;
    color: var(--spq-charcoal);
    margin: 0 0 0.8rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal-desc {
    font-size: 1.4rem;
    color: rgba(37, 37, 37, 0.5);
    margin: 0;
    line-height: 1.5;
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal-form form,
  #ProtocolQuiz-{{ section.id }} .spq__modal-success {
    padding: 2.4rem;
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal-success {
    text-align: center;
  }
  #ProtocolQuiz-{{ section.id }} .spq__modal-success[hidden],
  #ProtocolQuiz-{{ section.id }} .spq__modal-form[hidden] {
    display: none !important;
